#include <stdio.h>

int main() {
    int n;
    printf("Enter size of array (1 - 30): ");
    scanf("%d", &n);
    int num[30];
    printf("enter elements of Array one by one : ");
    for(int i=0; i<n; i++){
        scanf("%d", &num[i]);
    }
    int smallest = num[0];
    int second = 999999;

    for(int i=1; i<n; i++){
        if(num[i] < smallest){
            second = smallest;
            smallest = num[i];
        }else if(num[i] > smallest && num[i] < second){
            second = num[i];
        }
    }

    if(second == 999999){
        printf("Second smallest distinct element not found");
    }else{
    printf("second smallest : %d", second);
    }
}
