#include <stdio.h>

int main() {
    int n;
    printf("Enter Size of Array :");
    scanf("%d",&n);
    int num[50];
    for(int i=0; i<n; i++){
        scanf("%d", &num[i]);
    }
    int trgt;
    printf("Enter Target Element :");
    scanf("%d",&trgt);
    int index = -1;

    for(int i=0; i<n; i++){
        if(num[i] == trgt){
            index = i;
            break;
        }
    }

    if(index == -1){
        printf("Target Element Not Found");
        return 0;
    }

    if(index == 0){
        printf("Your Target Number is at 0th Index");
    }else if(index == 1){
        printf("Your Target Number is at 1st Index");
    }else if(index == 2){
        printf("Your Target Number is at 2nd Index");
    }else if(index == 3){
        printf("Your Target Number is at 3rd Index");
    }else{
        printf("Your Target Number is at %dth Index", index);
    }
}
    
