#include <stdio.h>

int main() {
    int n;
    printf("Enter Size Of Array : ");
    scanf("%d",&n);
    int num[30];
    printf("Enter Digits One By One : ");
    for(int i=0; i<n; i++){
        scanf("%d",&num[i]);
    }
    int positive = 0;
    int negative = 0;
    int zero = 0;

    for(int i=0; i<n; i++){
        if(num[i] < 0){
            negative++;
        }else if(num[i]==0){
            zero++;
        }else{
            positive++;
        }
    }
    printf("\n Negative Numbers : %d\n Positive Numbers : %d\n Zeros : %d",negative, positive, zero);
}
