#include <stdio.h>

int main() {
    int n;
    printf("Enter Size of Array :");
    scanf("%d",&n);
    int num[40];
    printf("Enter Elements one by one :");
    for(int i=0; i<n; i++){
        scanf("%d",&num[i]);
    }
    int even = 0;
    int odd = 0;
    int result;

    for(int i=0; i<n; i++){
        if(num[i] % 2 == 0){
            even += num[i];
        }else{
            odd += num[i];
        }
    }

    result = even - odd;

    if(result < 0){
        result = -(result);
    }

    printf("Difference : %d", result);
}
